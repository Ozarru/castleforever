msgstr "Exemplo de pagamento de aluguer de castelo"

#: .\base\templates\base\approach.html:31 .\base\templates\base\home.html:700
msgid "€3,000"
msgstr "€3.000"

#: .\base\templates\base\approach.html:32 .\base\templates\base\home.html:704
msgid "Initial deposit toward your castle rental"
msgstr "Depósito inicial para o aluguer do castelo"

#: .\base\templates\base\approach.html:38
#: .\base\templates\base\approach.html:116 .\base\templates\base\home.html:730
msgid "Illustrative repayment period"
msgstr "Período de reembolso ilustrativo"

