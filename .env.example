# --- Docker Compose only (see DEPLOYMENT_DOCKER.md) ------------------------
# Uncomment these when creating .env.stage / .env.prod, and change DATABASE_URL
# to use `db` as the host (e.g. postgres://user:pass@db:5432/castleforever).
# ENV_FILE=.env.stage
# COMPOSE_PROJECT_NAME=castleforever-stage
# APP_PORT=8001
# GUNICORN_WORKERS=3
# POSTGRES_DB=castleforever
# POSTGRES_USER=castleforever
# POSTGRES_PASSWORD=change-me

# --- Django core -----------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# --- Database --------------------------------------------------------------
# PostgreSQL is recommended on a VPS.
DATABASE_URL=postgres://castleforever:password@127.0.0.1:5432/castleforever

# --- Uploaded media storage (S3-compatible bucket) -------------------------
# Set USE_S3_MEDIA=1 to store uploads in the bucket instead of local disk.
USE_S3_MEDIA=1
S3_BUCKET_NAME=castleforever-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# AWS example: eu-west-3. Cloudflare R2: auto. MinIO: leave empty.
S3_REGION_NAME=auto
# Leave empty for AWS S3. Set for R2/B2/Wasabi/MinIO, e.g.:
#   Cloudflare R2   https://<account-id>.r2.cloudflarestorage.com
#   Backblaze B2    https://s3.eu-central-003.backblazeb2.com
#   Wasabi          https://s3.eu-central-1.wasabisys.com
#   MinIO           https://minio.example.com
S3_ENDPOINT_URL=
# Optional public hostname/CDN in front of the bucket (e.g. cdn.example.com).
# Leave empty to use presigned/endpoint URLs produced by the storage backend.
S3_CUSTOM_DOMAIN=
# Key prefix inside the bucket.
S3_LOCATION=media
# 0 for a public-read bucket behind a CDN, 1 for private buckets (signed URLs).
S3_QUERYSTRING_AUTH=0
# Usually only needed for providers that require an explicit ACL, e.g. public-read.
S3_DEFAULT_ACL=
# 0 keeps uploaded filenames unique instead of overwriting same-named files.
S3_FILE_OVERWRITE=0

# --- Optional security/logging overrides -----------------------------------
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO
